{
 "name":"@algora/desktop", "version":"0.1.0", "private":true,"type":"module", "main":"electron/main.cjs",
 "scripts": {
   "dev:web":"vite --host 127.0.0.1",
   "dev":"concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
   "build":"vite build", "typecheck":"tsc --noEmit",
   "dist:linux":"npm run build && electron-builder --linux AppImage deb",
   "dist:win":"npm run build && electron-builder --win nsis"
 },
 "dependencies":{"@algora/core":"*","react":"^19.2.0","react-dom":"^19.2.0","@monaco-editor/react":"^4.7.0","monaco-editor":"^0.55.1","lucide-react":"^0.468.0"},
 "devDependencies":{"@types/react":"^19.2.0","@types/react-dom":"^19.2.0","@vitejs/plugin-react":"^5.1.0","vite":"^7.2.0","electron":"^39.0.0","electron-builder":"^26.0.12","concurrently":"^9.2.1","wait-on":"^9.0.1"},
 "build":{"appId":"io.github.thurdass.algora","productName":"Algora","directories":{"output":"../../release"},"files":["dist/**/*","electron/**/*","package.json"],"linux":{"category":"Development","target":["AppImage","deb"],"maintainer":"thurdass"},"win":{"target":"nsis"},"nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true}}
}
