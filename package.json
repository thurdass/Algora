{
  "name": "algora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IDE moderna e interpretador independente para VisualG/Portugol",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @algora/desktop",
    "dev:web": "npm run dev:web -w @algora/desktop",
    "build": "npm run build -w @algora/desktop",
    "test": "tsx --test packages/core/test/*.test.ts tests/cli.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @algora/desktop",
    "check": "npm run typecheck && npm test && npm run build",
    "cli": "tsx packages/cli/src/index.ts",
    "dist:linux": "npm run dist:linux -w @algora/desktop",
    "dist:win": "npm run dist:win -w @algora/desktop",
    "test:e2e": "playwright install chromium && playwright test",
    "format": "prettier --write \"packages/**/*.ts\" \"apps/desktop/src/**/*.{ts,tsx,css}\"",
    "test:desktop": "tsx --test tests/desktop.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
